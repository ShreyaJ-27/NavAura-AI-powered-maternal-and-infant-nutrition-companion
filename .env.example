# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq AI Configuration (Vision & Conversational Reasoning)
GROQ_API_KEY=your-groq-api-key
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Vapi Voice AI Configuration
# NEXT_PUBLIC_VAPI_PUBLIC_KEY is safe to expose (client-side key)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
# VAPI_PRIVATE_KEY and VAPI_ASSISTANT_ID are server-side secrets — do NOT prefix with NEXT_PUBLIC_
VAPI_PRIVATE_KEY=your-vapi-private-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id